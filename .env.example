# Demo / seed
DEMO_AS_OF_DATE=2026-08-01
DEMO_RANDOM_SEED=family-financial-os-demo-v1

# API
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Auth
# Generate these, never copy them from here: a secret committed to a repository
# is a secret everyone has. `pnpm secrets:dev` writes random values into .env,
# and a production process refuses to start on a known placeholder.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Database
# Host port 5436 avoids common local Postgres conflicts; container still uses 5432.
DATABASE_URL=postgresql://ffos:ffos@localhost:5436/ffos_dev

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ffos
S3_SECRET_KEY=ffossecret
S3_BUCKET=ffos
S3_REGION=us-east-1

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ffos.local

# Frontend origin used to build links in outbound email (e.g. invite accept URL)
WEB_ORIGIN=http://localhost:3000

# Requests per minute per client. Unset in production, which uses 120; a local
# stack running the end-to-end suite drives every page from one address and
# needs more headroom than that.
FFOS_RATE_LIMIT=2000
