{
  "name": "@ffos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "echo 'lint ok'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/dashboard/dashboard.service.test.ts src/ai/ai-tools.test.ts src/metrics/household-metrics.consistency.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ffos/domain": "workspace:*",
    "@ffos/financial-engine": "workspace:*",
    "@ffos/schemas": "workspace:*",
    "@ffos/utils": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.2",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
