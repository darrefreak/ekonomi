    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ffos/domain": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@ffos/eslint-config": "workspace:*",
    "eslint": "^9.39.5"
  }
}
